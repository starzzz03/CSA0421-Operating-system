[Unit]
Description=University result portal (gunicorn)
After=network.target
[Service]
User=portal
Group=portal
WorkingDirectory=/opt/portal
ExecStart=/usr/bin/gunicorn --workers 3 --bind 127.0.0.1:8000 app:app
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=full
[Install]
WantedBy=multi-user.target
